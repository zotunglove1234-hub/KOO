# Copy this file to `.env` and fill in the real values. `.env` is git-ignored.
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the app bundle,
# so they are visible to anyone who has the APK. Never put the service_role /
# secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
